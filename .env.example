# Copy to .env. Everything is optional; the app runs without any of these.

# Enables AI extraction (much better with spoken recipes) and estimated ingredients
# for videos that don't list them. Without it, a rule-based caption parser is used.
ANTHROPIC_API_KEY=

JWT_SECRET=change-me-to-a-long-random-string

# Lets Instagram Reels share their captions (Meta app token for the oEmbed API).
INSTAGRAM_OEMBED_TOKEN=

# Build the backend with faster-whisper for speech-to-text.
WITH_WHISPER=true

# iCloud link to your "Save to Reelish" shortcut (see docs/ios-shortcut.md).
# Shown as the "Get the shortcut" button in Settings on iPhone.
SHORTCUT_URL=

# Opt-in: download shared videos so their speech can be transcribed.
# Check TikTok's and Instagram's terms before turning this on.
WITH_DOWNLOAD=false
ENABLE_VIDEO_DOWNLOAD=false
